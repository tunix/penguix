# penguix desktop defaults — schema overrides
# Lexically sorts after bluefin's zz0/zz1 files; for the same key, later files win.
# Converted from custom/etc/dconf/db/distro.d (dconf system db).
#
# Settings for extensions whose schemas are NOT compiled system-wide (they ship
# inside the extension directory and load at runtime) cannot live here — those
# remain in custom/etc/dconf/db/distro.d/99-penguix-extension-settings.
# Apply changes on a running system with:
#   sudo glib-compile-schemas /usr/share/glib-2.0/schemas/
# (Keys the user has explicitly set keep winning; reset them with
#   gsettings reset <schema> <key>  to see the new default.)

#-------------- DESKTOP --------------#

[org.gnome.desktop.background]
picture-options = 'zoom'
primary-color = '000000'
secondary-color = 'FFFFFF'

[org.gnome.desktop.interface]
accent-color = 'teal'
enable-hot-corners = false
clock-format = '24h'
clock-show-date = true
clock-show-weekday = true
cursor-theme = 'Yaru'
text-scaling-factor = 0.9
monospace-font-name = 'JetBrains Mono Regular 11'

[org.gnome.desktop.wm.preferences]
button-layout = 'appmenu:minimize,maximize,close'

[org.gnome.desktop.wm.keybindings]
# Unbind Ctrl+Alt arrows so Ghostty split navigation can use them.
switch-to-workspace-left = ['<Super>Page_Up', '<Super>KP_Prior', '<Super><Alt>Left']
switch-to-workspace-right = ['<Super>Page_Down', '<Super>KP_Next', '<Super><Alt>Right']
switch-to-workspace-up = @as []
switch-to-workspace-down = @as []
move-to-workspace-left = ['<Super><Shift>Page_Up', '<Super><Shift>KP_Prior', '<Super><Shift><Alt>Left']
move-to-workspace-right = ['<Super><Shift>Page_Down', '<Super><Shift>KP_Next', '<Super><Shift><Alt>Right']
move-to-workspace-up = @as []
move-to-workspace-down = @as []

[org.gnome.desktop.sound]
allow-volume-above-100-percent = true
event-sounds = true
theme-name = 'freedesktop'

[org.gnome.desktop.peripherals.keyboard]
repeat = true
repeat-interval = uint32 30

[org.gnome.desktop.peripherals.touchpad]
tap-to-click = true
send-events = true
natural-scroll = true
two-finger-scrolling-enabled = true
disable-while-typing = true

[org.gnome.desktop.peripherals.mouse]
natural-scroll = false

[org.gnome.desktop.privacy]
remove-old-trash-files = true
remove-old-temp-files = true
old-files-age = uint32 3

#-------------- GTK / DATETIME --------------#

[org.gtk.Settings.FileChooser]
sort-directories-first = true

[org.gtk.gtk4.Settings.FileChooser]
sort-directories-first = true
sort-order = 'ascending'

[org.gnome.desktop.datetime]
automatic-timezone = true

#-------------- MUTTER --------------#

[org.gnome.mutter]
workspaces-only-on-primary = false
center-new-windows = true

#-------------- NAUTILUS / TWEAKS --------------#

[org.gnome.nautilus.icon-view]
default-zoom-level = 'small-plus'

[org.gnome.nautilus.window-state]
initial-size = (1210, 750)

[org.gnome.tweaks]
show-extensions-notice = false

#-------------- PTYXIS --------------#

[org.gnome.Ptyxis]
interface-style = 'system'
restore-session = false
restore-window-size = true
audible-bell = false
cursor-shape = 'underline'
profile-uuids = ['2871e8027773ae74d6c87a5f659bbc74']
default-profile-uuid = '2871e8027773ae74d6c87a5f659bbc74'

[org.gnome.Ptyxis.Profile:path=/org/gnome/Ptyxis/Profiles/2871e8027773ae74d6c87a5f659bbc74/]
palette = 'catppuccin-dynamic'

#-------------- SETTINGS DAEMON --------------#

[org.gnome.settings-daemon.plugins.color]
night-light-enabled = true
night-light-temperature = uint32 2700

[org.gnome.settings-daemon.plugins.power]
power-button-action = 'nothing'
sleep-inactive-ac-timeout = uint32 0
sleep-inactive-ac-type = 'nothing'
sleep-inactive-battery-timeout = uint32 900
sleep-inactive-battery-type = 'suspend'

[org.gnome.settings-daemon.plugins.media-keys]
home = ['<Super>f']
www = ['<Super>b']
calculator = ['<Super>c']
custom-keybindings = ['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/']
volume-step = uint32 2

[org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:path=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/]
binding = '<Super>t'
command = 'ghostty'
name = 'Start Ghostty'

[org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:path=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/]
binding = '<Ctrl><Shift>Space'
command = '/home/linuxbrew/.linuxbrew/bin/1password --quick-access'
name = '1Password Quick Access'

#-------------- GNOME SHELL --------------#

[org.gnome.shell]
favorite-apps = ['com.brave.Browser.desktop', 'org.gnome.Nautilus.desktop', 'com.spotify.Client.desktop', 'com.mitchellh.ghostty.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Settings.desktop', 'org.telegram.desktop.desktop', 'com.slack.Slack.desktop', 'com.discordapp.Discord.desktop', 'md.obsidian.Obsidian.desktop', 'cursor.desktop']
enabled-extensions = ['appindicatorsupport@rgcjonas.gmail.com', 'blur-my-shell@aunetx', 'gsconnect@andyholmes.github.io', 'tailscale-gnome-qs@tailscale-qs.github.io', 'search-light@icedman.github.com', 'nightthemeswitcher@romainvigier.fr', 'grand-theft-focus@zalckos.github.com', 'solaar-extension@sidevesh', 'tilingshell@ferrarodomenico.com', 'caffeine@patapon.info']

[org.gnome.system.location]
enabled = true

[org.gnome.shell.weather]
automatic-location = true
locations = [<(uint32 2, <('Izmir-Adnan Menderes Airport', 'LTBJ', false, [(0.66787933291426083, 0.47385689191646041)], @a(dd) [])>)>]

[org.gnome.desktop.input-sources]
sources = [('xkb', 'tr')]

#-------------- BLUR MY SHELL (system-wide schema) --------------#

[org.gnome.shell.extensions.blur-my-shell.panel:path=/org/gnome/shell/extensions/blur-my-shell/panel/]
force-light-text = true
override-background = true
override-background-dynamically = false
static-blur = false
style-panel = uint32 2
unblur-in-overview = false
