# vim: set ft=just :
# penguix — userspace personalization entry point.
# Conventions mirror /usr/share/ublue-os/just (ujust) so the recipes read the
# same as upstream ones; invoked via this justfile or `just -g` after
# `just penguix-install-global-justfile`.

set allow-duplicate-recipes := true
set ignore-comments := true

# Absolute path to the repo (dir of this justfile). Recipes must reference
# files via {{repo_root}} so they work from any working directory.
repo_root := justfile_directory()

_default:
    #!/usr/bin/env bash
    echo "penguix — userspace personalization (no image layering)"
    just --list --list-heading $'Available commands:\n' --list-prefix $' - '

import "recipes/brew.just"
import "recipes/dconf.just"
import "recipes/extensions.just"
import "recipes/home.just"
import "recipes/system.just"
import? "recipes/work.just"

# One-shot: bring a fresh system to the penguix state. Each step is
# idempotent and asks for confirmation, so this is safe to re-run.
[group('penguix')]
penguix-setup:
    #!/usr/bin/env bash
    set -euo pipefail
    J="{{repo_root}}/Justfile"
    echo "==> penguix userspace setup"
    if gum confirm "1/7 Software (brew formulas + casks)?"; then
        just --justfile "$J" penguix-brew
    fi
    if gum confirm "2/7 Flatpaks (Brewfile DSL)?"; then
        just --justfile "$J" penguix-flatpaks
    fi
    if gum confirm "3/7 Desktop settings (per-user dconf)?"; then
        just --justfile "$J" penguix-dconf-apply
    fi
    if gum confirm "4/7 GNOME Shell extensions (user-installed)?"; then
        just --justfile "$J" penguix-extensions
    fi
    if gum confirm "5/7 Home fixes (Brave flags, autostart)?"; then
        just --justfile "$J" penguix-home
    fi
    if gum confirm "6/7 Login shell -> fish (sudo usermod)?"; then
        just --justfile "$J" change-shell
    fi
    if gum confirm "7/7 sysctl TTL=65 (sudo, opt-in anti-fingerprinting)?"; then
        just --justfile "$J" penguix-sysctl-ttl
    fi
    echo "Done. Log out/in (or restart GNOME Shell) so extension and dconf changes fully apply."

# Install the recipes as the global justfile (~/.config/just/justfile), so
# they run via `just -g <recipe>` from any directory.
#
# The global file is a GENERATED delegating shim: just has no catch-all
# recipe and cannot import files across directories without breaking
# justfile_directory(), so every penguix recipe is mirrored as a thin
# wrapper that re-executes the repo Justfile by absolute path. Regenerate
# after adding recipes.
[group('penguix')]
penguix-install-global-justfile:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{repo_root}}"
    link="$HOME/.config/just/justfile"
    if [ -e "$link" ] && [ ! -f "$link" ]; then
        echo "$link exists and is neither a file nor creatable; refusing." >&2
        exit 1
    fi
    mkdir -p "$HOME/.config/just"
    names="$(just --justfile "$root/Justfile" --summary)"
    if [ -z "$names" ]; then
        echo "No recipes found; nothing to install." >&2
        exit 1
    fi
    {
        echo "# penguix global justfile shim (auto-generated by penguix-install-global-justfile)"
        echo "# Delegates every penguix recipe to the repo justfile by absolute path."
        echo "# Regenerate with: just --justfile $root/Justfile penguix-install-global-justfile"
        echo "set positional-arguments := true"
        for n in $names; do
            echo ""
            echo "[group('penguix')]"
            echo "$n *args:"
            echo "    @just --justfile $root/Justfile $n \"\$@\""
        done
    } > "$link"
    echo "Global justfile shim written: $link -> $root/Justfile ($(echo $names | wc -w | tr -d ' ') recipes)"
    echo "Try from any directory: just -g penguix-setup"

# Show what of the penguix state is already applied.
[group('penguix')]
penguix-status:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "brew:"
    command -v brew >/dev/null && brew list --formula -1 | wc -l | xargs echo "  formulas:" || echo "  brew not installed yet"
    echo "flatpaks (user):"
    flatpak list --user --app --columns=application 2>/dev/null | sed 's/^/  /'
    echo "user shell extensions:"
    ls -1 "$HOME/.local/share/gnome-shell/extensions" 2>/dev/null | sed 's/^/  /'
    echo "dconf user settings: $([ -s "$HOME/.config/dconf/user" ] 2>/dev/null && echo present || echo empty)"
    echo "brave flags: $([ -f "$HOME/.var/app/com.brave.Browser/config/brave-flags.conf" ] && echo deployed || echo missing)"
